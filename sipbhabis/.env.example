# Canonical URL used in metadata, sitemap, and Midtrans finish redirect.
NEXT_PUBLIC_SITE_URL=https://sipbhabis.web.app

# Firebase Admin (named Firestore database: sipbhabis). Server only.
FIREBASE_PROJECT_ID=skoolnow-ea6ff
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=sipbhabis

# Midtrans Snap. Leave production flags false until the merchant is live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Optional. Without this key the pesan untuk HR/loket stays on the local draft.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
