# Canonical URL used in metadata, sitemap, and Midtrans finish redirect.
NEXT_PUBLIC_SITE_URL=https://burnoutdulu.web.app

# Firebase Admin (named Firestore database: burnoutdulu). Server only.
FIREBASE_PROJECT_ID=skoolnow-ea6ff
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_DATABASE_ID=burnoutdulu

# Midtrans Snap. Leave production flags false until the merchant is live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
