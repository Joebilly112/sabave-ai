{
  "firestore": {
    "database": "praktiksiap",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "target": "praktiksiap",
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "asia-southeast1",
      "minInstances": 0,
      "maxInstances": 3,
      "memory": "512MiB",
      "cpu": 1
    }
  }
}
